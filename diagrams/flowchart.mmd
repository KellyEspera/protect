flowchart TB
    Start([Start]) --> Open[User opens PROTECT]
    Open --> Access{Public or staff?}

    subgraph PublicFlow[Public access]
        direction TB
        Announcements[Public announcements]
        Needs[Needs submission]
    end

    Access -- Public --> Announcements
    Access -- Public --> Needs
    Announcements --> PublicData[(Announcements)]
    Needs --> NeedsData[(Survey responses + needs photos)]

    subgraph StaffFlow[Staff access]
        direction TB
        AuthCheck{Valid Supabase Auth?}
        Profile[Fetch profile and role]
        RoleCheck{Role authorized?}
        Dashboard[Community dashboard]
        Choose{Choose module}
    end

    Access -- Staff --> AuthCheck
    AuthCheck -- No --> Login[Login page]
    AuthCheck -- Yes --> Profile
    Profile --> RoleCheck
    RoleCheck -- No --> Restricted[Access restricted]
    RoleCheck -- Yes --> Dashboard
    Dashboard --> Choose

    subgraph Modules[Barangay modules]
        direction TB
        Residents[Resident Profiling]
        QR[QR Verification]
        GIS[GIS Household Map]
        Crime[Crime & Incident]
        Hotspot[Crime Hotspot Map]
        Disaster[Disaster Vulnerability]
        Beneficiary[Beneficiary Tracking]
        Analytics[Analytics]
        Reports[DILG Reports]
        Ordinance[Ordinance Archive]
        AnnouncementsAdmin[Announcements Admin]
        Users[User Management]
        AdminTools[System & Audit]
    end

    Choose --> Residents
    Choose --> QR
    Choose --> GIS
    Choose --> Crime
    Choose --> Hotspot
    Choose --> Disaster
    Choose --> Beneficiary
    Choose --> Analytics
    Choose --> Reports
    Choose --> Ordinance
    Choose --> AnnouncementsAdmin
    Choose --> Users
    Choose --> AdminTools

    subgraph Data[App data stores]
        direction TB
        ResidentsDB[(Residents + households)]
        IncidentsDB[(Incidents)]
        BenefitsDB[(Beneficiaries + programs)]
        AnnDB[(Announcements)]
        OrdinanceDB[(Ordinances + PDFs)]
        BackupDB[(system-backups)]
        AuditDB[(Audit logs)]
    end

    Residents --> ResidentsDB
    QR --> ResidentsDB
    GIS --> ResidentsDB
    Crime --> IncidentsDB
    Hotspot --> IncidentsDB
    Disaster --> IncidentsDB
    Beneficiary --> BenefitsDB
    AnnouncementsAdmin --> AnnDB
    Ordinance --> OrdinanceDB
    AdminTools --> AuditDB
    AdminTools --> BackupDB

    GIS --> Geo[Nominatim search]
    GIS --> Tiles[OpenStreetMap tiles]
    Crime --> Tiles
    Hotspot --> Tiles
    Disaster --> Tiles

    QR --> Document[Generated certificates + QR payloads]

    subgraph BackupAutomation[Backup automation]
        direction TB
        Cron[pg_cron weekly trigger]
        Export[backup-export function]
        Store[(system-backups bucket)]
    end

    Cron --> Export
    Export --> Store
    AdminTools --> Store

    ResidentsDB --> Backend[Supabase backend]
    IncidentsDB --> Backend
    BenefitsDB --> Backend
    AnnDB --> Backend
    OrdinanceDB --> Backend
    AuditDB --> Backend
    Store --> Backend

    Backend --> Session{Continue session?}
    Session -- Yes --> Dashboard
    Session -- No --> Logout([User logs out])
