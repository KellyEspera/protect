flowchart TD
    %% ---- External entities ----
    Staff[Barangay Staff]
    DILG[DILG / Government]
    Public[Resident / Public]

    %% ---- Processes ----
    P1([1.0 Authenticate<br/>& Authorize])
    P2([2.0 Manage Residents<br/>& Households / GIS])
    P3([3.0 Log Incidents<br/>& Map Crime])
    P4([4.0 Manage Beneficiaries<br/>& Assistance])
    P5([5.0 QR Verification<br/>& Documents])
    P6([6.0 Public Content<br/>Announcements & Ordinances])
    P7([7.0 Needs Intake])
    P8([8.0 Analytics<br/>& DILG Reports])

    %% ---- Data stores ----
    D1[(D1 profiles)]
    D2[(D2 residents · households)]
    D3[(D3 incidents · disaster_risk_zones)]
    D4[(D4 beneficiaries · assistance_programs)]
    D5[(D5 qr_verifications)]
    D6[(D6 announcements · ordinances)]
    D7[(D7 survey_responses)]
    D8[(D8 population_history · audit_logs)]
    S1[(Storage: photos · PDFs)]

    %% ---- Auth ----
    Staff --> P1
    P1 --> D1

    %% ---- Residents / households ----
    Staff --> P2
    P2 --> D2
    D2 --> P2

    %% ---- Incidents ----
    Staff --> P3
    P3 --> D3
    D3 --> P3

    %% ---- Beneficiaries ----
    Staff --> P4
    P4 --> D4
    D4 --> P4

    %% ---- QR / documents ----
    Staff --> P5
    D2 --> P5
    P5 --> D5
    P5 --> D4

    %% ---- Public content ----
    Staff --> P6
    P6 --> D6
    D6 --> P6
    P6 --> Public
    P6 --> S1

    %% ---- Needs intake ----
    Public --> P7
    Staff --> P7
    P7 --> D7
    P7 --> S1
    D7 --> P7

    %% ---- Analytics / reports ----
    Staff --> P8
    D2 --> P8
    D3 --> P8
    D4 --> P8
    D7 --> P8
    D8 --> P8
    P8 --> DILG
