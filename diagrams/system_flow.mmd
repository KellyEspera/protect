flowchart TB
  Start([Open PROTECT]) --> App[React app loads]
  App --> Router[App.jsx route + auth bootstrap]
  Router --> Access{Public or staff?}

  subgraph PublicFlow[Public access]
    direction TB
    PublicRoute[Public portal]
    PublicAnnounce[View public announcements]
    NeedsForm[Submit community need]
  end

  Access -- Public --> PublicRoute
  PublicRoute --> PublicAnnounce
  PublicRoute --> NeedsForm
  PublicAnnounce --> PublicData[(Public announcements)]
  NeedsForm --> NeedsData[(Survey responses + needs photos)]

  subgraph StaffFlow[Staff access]
    direction TB
    Login[Login]
    Session{Valid Supabase session?}
    Profile[Load profile and role]
    Permission{Role allowed?}
    Dashboard[Community dashboard]
    Module{Choose module}
  end

  Access -- Staff --> Login
  Login --> Session
  Session -- No --> Login
  Session -- Yes --> Profile
  Profile --> Permission
  Permission -- No --> Restricted[Access restricted]
  Permission -- Yes --> Dashboard
  Dashboard --> Module

  subgraph Modules[Permitted modules]
    direction LR

    subgraph CoreModules[Core service modules]
      direction TB
      Residents[Resident Profiling]
      QR[QR Verification]
      GIS[GIS Household Map]
      Crime[Crime & Incident]
      Hotspot[Crime Hotspot Map]
      Disaster[Disaster Vulnerability]
      Beneficiary[Beneficiary Tracking]
    end

    subgraph PlanningModules[Planning and reporting]
      direction TB
      Analytics[Analytics & reports]
      Reports[DILG Reports]
      Ordinance[Ordinance Archive]
      AnnounceAdmin[Announcements Admin]
    end

    subgraph AdminModules[Admin and system]
      direction TB
      AdminTools[System & Audit]
    end
  end

  Module --> Residents
  Module --> QR
  Module --> GIS
  Module --> Crime
  Module --> Hotspot
  Module --> Disaster
  Module --> Beneficiary
  Module --> Analytics
  Module --> Reports
  Module --> Ordinance
  Module --> AnnounceAdmin
  Module --> AdminTools

  subgraph Backend[Supabase backend]
    direction TB
    Auth[Supabase Auth]
    DB[(PostgreSQL + RLS)]
    Storage[(Storage buckets)]
    Audit[(Audit logs)]
    Cron[pg_cron weekly backup]
    Export[backup-export Edge Function]
  end

  Login --> Auth
  Session --> Auth
  Profile --> DB
  Residents --> DB
  QR --> DB
  GIS --> DB
  Crime --> DB
  Hotspot --> DB
  Disaster --> DB
  Beneficiary --> DB
  Analytics --> DB
  Reports --> DB
  AdminTools --> DB
  Ordinance --> DB
  AnnounceAdmin --> DB
  DB --> Audit

  GIS --> Geo[Nominatim / OSM geocoder]
  GIS --> Tiles[OpenStreetMap tiles]
  Crime --> Tiles
  Hotspot --> Tiles
  Disaster --> Tiles

  Crime --> IncidentPhoto[(Incident photos)]
  AnnounceAdmin --> AnnPhoto[(Announcement photos)]
  NeedsForm --> NeedsPhoto[(Needs photos)]
  Ordinance --> OrdinancePDF[(Ordinance PDFs)]
  AdminTools --> BackupStore[(system-backups bucket)]
  Cron --> Export
  Export --> BackupStore
  Export --> DB
  DB --> Storage
  Storage --> BackupStore

  DB --> Continue{Continue session?}
  Continue -- Yes --> Dashboard
  Continue -- No --> Logout([Logout])
